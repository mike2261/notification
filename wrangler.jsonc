/**
 * tuni-noti — walking skeleton (design.md §7.0).
 *
 * Deliberately minimal: no D1, no Queues, no Durable Objects. The skeleton
 * exists to prove ONE thing that no amount of code review can prove — that the
 * GCP topology (a second WIF provider + a dedicated SA + an FCM role binding)
 * actually mints a usable FCM access token and lands a push on a real handset.
 * Bindings for the real service arrive in design.md §6 step 4.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tuni-noti",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-07",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Runtime version identity for /healthz — scripts/deploy.sh smokes the
	// uploaded version at 0% traffic and asserts the responding version id.
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "NOTI_D1",
			"database_name": "tuni-noti-d1",
			"database_id": "fbe5ef27-123a-440c-9a47-93895c585840",
			"migrations_dir": "migrations"
		}
	],
	// NOTI_QUEUE / NOTI_WEEKLY_QUEUE: this Worker only consumes (robo-worker
	// produces, out of scope here). SEND_QUEUE: internal to this Worker — the
	// flush cron produces, a send consumer consumes (design.md §1.2, §4.5, §4.6).
	"queues": {
		"consumers": [
			{
				"queue": "tuni-noti-events",
				"max_batch_size": 100,
				"max_retries": 3,
				"dead_letter_queue": "tuni-noti-events-dlq"
			},
			{
				"queue": "tuni-noti-weekly",
				"max_batch_size": 100,
				"max_retries": 3,
				"dead_letter_queue": "tuni-noti-weekly-dlq"
			},
			{
				"queue": "tuni-noti-send",
				"max_batch_size": 100,
				// Lower than the inbound queues: a send failure is retried by FCM's
				// own classifier (src/fcm/client.ts) up to the point it's terminal,
				// so a consumer-level retry storm on top of that just wastes budget
				// (design.md §4.6, §5.3 "its own retry policy").
				"max_retries": 2,
				"dead_letter_queue": "tuni-noti-send-dlq"
			}
		],
		"producers": [
			{ "queue": "tuni-noti-send", "binding": "SEND_QUEUE" }
		]
	},
	// The 1-minute flush (design.md §4.5 step 2). A <1h interval gets 30s CPU,
	// which is why the flush must stay set-based (§5).
	// The 1-minute flush plus the hourly sweeper backstop (§4.5 step 4).
	// scheduled() routes on controller.cron.
	"triggers": {
		"crons": ["* * * * *", "0 * * * *"]
	},
	"upload_source_maps": true,
	// WIF_PRIVATE_KEY and SKELETON_TOKEN are set as dashboard secrets, never in
	// this file. keep_vars stops a deploy from wiping them. Everything in the
	// "vars" block below IS overwritten from this file on every deploy — edit
	// it here, not in the dashboard.
	"keep_vars": true,
	"vars": {
		// --- FILL IN AFTER THE GCP CONSOLE WORK (docs/walking-skeleton.md §1) ---
		// The Worker's own public URL. GCP's WIF provider fetches
		// {WIF_ISSUER}/auth/jwks to verify our self-signed assertions, so this
		// MUST equal the provider's configured issuer exactly — robo-worker's
		// provider cannot be reused for precisely this reason (design.md §4.6).
		"WIF_ISSUER": "https://tuni-noti.anhduc22601.workers.dev",
		"WIF_SUBJECT": "tuni-noti",
		// STS wants the audience as a "full resource name": leading `//`, no
		// protocol. The GCP Console shows it with `https://` and the API rejects
		// that form.
		"WIF_AUDIENCE": "//iam.googleapis.com/projects/273162862419/locations/global/workloadIdentityPools/robo-cf-worker-pool/providers/tuni-noti",
		// Dedicated SA — NOT robo-worker's bridge SA (design.md §4.6 step 3).
		"FCM_SA_EMAIL": "tuni-noti@ai-robotics-496803.iam.gserviceaccount.com",
		// Firebase project id (the string id, not the number) — it goes straight
		// into the messages:send path. Differs from the GCP project the SA lives
		// in (ai-robotics-496803) — a genuine cross-project setup.
		"FCM_PROJECT_ID": "robo-tuni-app",
		// Off by default. The skeleton push route mints a GCP token and sends
		// real pushes; it stays disabled unless someone is actively running §7.0.
		"SKELETON_ENABLED": "0",
		// Dark rollout (design.md §8). Off means the send consumer marks every
		// due notification suppressed_dark AT SEND TIME, so flipping this on
		// releases nothing retroactively. Ship dark, verify volume and
		// coalescing against real traffic, then enable for internal parents.
		"PUSH_ENABLED": "0",
		// --- FILL IN once robo-worker's auth migration (design.md §1.4) ships its
		// JWKS endpoint. Until then these are placeholders — the parent API will
		// 401 every request in production, which is the correct failure mode for
		// "the upstream contract isn't live yet" rather than silently accepting
		// unverifiable tokens.
		"PARENT_JWKS_URL": "https://robo-worker.example/auth/jwks",
		"PARENT_JWT_ISSUER": "https://robo-worker.example",
		// Real, known value from design.md §1.4 — not a placeholder.
		"PARENT_JWT_AUDIENCE": "robo-worker/parent"
	},
	"env": {
		// wrangler envs do NOT inherit — every binding and var is duplicated here
		// on purpose (design.md §3.3). Values are fakes; no test touches GCP.
		"test": {
			"version_metadata": {
				"binding": "CF_VERSION_METADATA"
			},
			"d1_databases": [
				{
					"binding": "NOTI_D1",
					"database_name": "tuni-noti-d1-test",
					"database_id": "00000000-0000-0000-0000-000000000000",
					"migrations_dir": "migrations"
				}
			],
			// Distinct queue names from production so local test runs never touch
			// real Cloudflare queues; vitest-pool-workers simulates them locally.
			"queues": {
				"consumers": [
					{ "queue": "tuni-noti-events-test", "max_batch_size": 100, "max_retries": 3, "dead_letter_queue": "tuni-noti-events-test-dlq" },
					{ "queue": "tuni-noti-weekly-test", "max_batch_size": 100, "max_retries": 3, "dead_letter_queue": "tuni-noti-weekly-test-dlq" },
					{ "queue": "tuni-noti-send-test", "max_batch_size": 100, "max_retries": 2, "dead_letter_queue": "tuni-noti-send-test-dlq" }
				],
				"producers": [
					{ "queue": "tuni-noti-send-test", "binding": "SEND_QUEUE" }
				]
			},
			"vars": {
				"WIF_ISSUER": "https://tuni-noti.test",
				"WIF_SUBJECT": "tuni-noti",
				"WIF_AUDIENCE": "//iam.googleapis.com/projects/000/locations/global/workloadIdentityPools/test-pool/providers/test-provider",
				"FCM_SA_EMAIL": "tuni-noti@test.iam.gserviceaccount.com",
				"FCM_PROJECT_ID": "test-firebase-project",
				"SKELETON_ENABLED": "1",
				"SKELETON_TOKEN": "test-skeleton-token",
				"PUSH_ENABLED": "1",
				"PARENT_JWKS_URL": "https://robo-worker.test/auth/jwks",
				"PARENT_JWT_ISSUER": "https://robo-worker.test",
				"PARENT_JWT_AUDIENCE": "robo-worker/parent"
			}
		}
	}
}
