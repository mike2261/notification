{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ESNext"],
    "types": ["./worker-configuration.d.ts", "node", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "*.ts", "*.mts"]
}
